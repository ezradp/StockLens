# StockLens environment (salin file ini ke ".env" — jangan pernah commit kredensial)

# --- Wajib: Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Wajib untuk migrasi DB & operasi server-privileged ---
# Postgres pooled connection string (Supabase → Database → Connection string)
DATABASE_URL=
# Server-only; TIDAK PERNAH masuk client bundle (diakses hanya src/lib/supabase/server.ts)
SUPABASE_SERVICE_ROLE_KEY=

# --- Opsional (Phase 3): provider harga historis dengan free key ---
# tiingo | twelvedata | none
PRICE_PROVIDER=none
PRICE_PROVIDER_API_KEY=
